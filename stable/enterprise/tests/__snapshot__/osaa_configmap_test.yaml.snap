    kind: ConfigMap
    metadata:
      annotations:
        bar: baz
        foo: bar
      labels:
        app.kubernetes.io/instance: test-release
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: test-release-enterprise
        app.kubernetes.io/part-of: anchore
        app.kubernetes.io/version: 9.9.9
        bar: baz
        foo: bar
        helm.sh/chart: enterprise-9.9.9
      name: test-release-enterprise
      namespace: test-namespace
  2: |
    apiVersion: v1
    data:
      config.yaml: "# Anchore Object Store and Analysis Archive Migration configuration file, mounted from a configmap\n#\nservice_dir: ${ANCHORE_SERVICE_DIR}\ntmp_dir: ${ANCHORE_TMP_DIR}\n\nlogging:\n  colored_logging: false\n  exception_backtrace_logging: false\n  exception_diagnose_logging: false\n  file_retention_rule: 10\n  file_rotation_rule: 10 MB\n  log_level: <ALLOW_API_CONFIGURATION>\n  server_access_logging: true\n  server_log_level: info\n  server_response_debug_logging: false\n  structured_logging: false\n\nserver:\n  max_connection_backlog: 2048\n  max_wsgi_middleware_worker_count: 50\n  max_wsgi_middleware_worker_queue_size: 100\n  process_worker_count: 1\n  ssl_cert: false\n  ssl_chain: false\n  ssl_enable: false\n  ssl_key: false\n  timeout_graceful_shutdown: false\n  timeout_keep_alive: 5\n\nallow_awsecr_iam_auto: true\nhost_id: \"${ANCHORE_HOST_ID}\"\ninternal_ssl_verify: false\nimage_analyze_timeout_seconds: 36000\n\nglobal_client_connect_timeout: ${ANCHORE_GLOBAL_CLIENT_CONNECT_TIMEOUT}\nglobal_client_read_timeout: ${ANCHORE_GLOBAL_CLIENT_READ_TIMEOUT}\n\nlicense_file: ${ANCHORE_LICENSE_FILE}\nauto_restart_services: false\n\nmax_source_import_size_mb: 100\nmax_import_content_size_mb: 100\n\nmax_compressed_image_size_mb: -1\n\naudit:\n  enabled: true\n  mode: log\n  verbs:\n    - post\n    - put\n    - delete\n    - patch\n  resource_uris:\n    - \"/accounts\"\n    - \"/accounts/{account_name}\"\n    - \"/accounts/{account_name}/state\"\n    - \"/accounts/{account_name}/users\"\n    - \"/accounts/{account_name}/users/{username}\"\n    - \"/accounts/{account_name}/users/{username}/api-keys\"\n    - \"/accounts/{account_name}/users/{username}/api-keys/{key_name}\"\n    - \"/accounts/{account_name}/users/{username}/credentials\"\n    - \"/rbac-manager/roles\"\n    - \"/rbac-manager/roles/{role_name}/members\"\n    - \"/rbac-manager/saml/idps\"\n    - \"/rbac-manager/saml/idps/{name}\"\n    - \"/rbac-manager/saml/idps/{name}/user-group-mappings\"\n    - \"/system/user-groups\"\n    - \"/system/user-groups/{group_uuid}\"\n    - \"/system/user-groups/{group_uuid}/roles\"\n    - \"/system/user-groups/{group_uuid}/users\"\n    - \"/user/api-keys\"\n    - \"/user/api-keys/{key_name}\"\n    - \"/user/credentials\"\n\nmetrics:\n  enabled: false\n  auth_disabled: false\n\ndefault_admin_password: \"${ANCHORE_ADMIN_PASSWORD}\"\ndefault_admin_email: admin@myanchore\n\nconfiguration:\n  api_driven_configuration_enabled: true\n\nkeys:\n  secret: \"${ANCHORE_SAML_SECRET}\"\n  public_key_path: null\n  private_key_path: null\n\nuser_authentication:\n  oauth:\n    default_token_expiration_seconds: 3600\n    refresh_token_expiration_seconds: 86400\n  sso_require_existing_users: false\n  allow_api_keys_for_saml_users: false\n  max_api_key_age_days: 365\n  max_api_keys_per_user: 100\n  remove_deleted_user_api_keys_older_than_days: 365\n  disallow_native_users: false\n  log_saml_assertions: false\ncredentials:\n  database:\n    user: \"${ANCHORE_DB_USER}\"\n    password: \"${ANCHORE_DB_PASSWORD}\"\n    host: \"${ANCHORE_DB_HOST}\"\n    port: \"${ANCHORE_DB_PORT}\"\n    name: \"${ANCHORE_DB_NAME}\"\n    db_connect_args:\n      timeout: ${ANCHORE_DB_TIMEOUT}\n      ssl: false\n    db_pool_size: ${ANCHORE_DB_POOL_SIZE}\n    db_pool_max_overflow: ${ANCHORE_DB_POOL_MAX_OVERFLOW}\n\naccount_gc:\n  max_resource_gc_chunk: 4096\n  max_deletion_threads: 4\n\nvex_annotation_author: <ALLOW_API_CONFIGURATION>\nobject_store:\n  direct_access: false\n\nservices:\n  apiext:\n    enabled: true\n    logging:\n      colored_logging: false\n      exception_backtrace_logging: false\n      exception_diagnose_logging: false\n      file_retention_rule: 10\n      file_rotation_rule: 10 MB\n      log_level: <ALLOW_API_CONFIGURATION>\n      server_access_logging: true\n      server_log_level: info\n      server_response_debug_logging: false\n      structured_logging: false\n    image_content:\n      remove_license_content_from_sbom_return: <ALLOW_API_CONFIGURATION>\n    endpoint_hostname: ${ANCHORE_ENDPOINT_HOSTNAME}\n    listen: \"0.0.0.0\"\n    port: ${ANCHORE_PORT}\n    cycle_timers:\n      api_key_token_cleanup: 43200\n      oauth_token_cleanup: 21600\n      service_heartbeat: 60\n      system_config_environment_watcher: 20\n      system_config_refresh_watcher: 20\n    external_hostname: null\n    external_port: null\n    external_tls: false\n    server:\n      max_connection_backlog: 2048\n      max_wsgi_middleware_worker_count: 50\n      max_wsgi_middleware_worker_queue_size: 100\n      process_worker_count: 1\n      ssl_cert: false\n      ssl_chain: false\n      ssl_enable: false\n      ssl_key: false\n      timeout_graceful_shutdown: false\n      timeout_keep_alive: 5\n\n  analyzer:\n    enabled: true\n    analyzer_scanner_config:\n      content_search:\n        enabled: true\n        layer_scope: squashed\n        match_params: []\n        regexp_match: []\n      file_contents:\n        enabled: true\n        file_list:\n        - /etc/passwd\n        - /anchore_hints.json\n        layer_scope: squashed\n        max_file_size_kb: 1000\n      malware:\n        clamav:\n          db_update_enabled: true\n          enabled: <ALLOW_API_CONFIGURATION>\n          max_scan_time: 1800000\n      secret_search:\n        enabled: true\n        layer_scope: squashed\n        match_params:\n        - MAXFILESIZE=10000\n        - STOREONMATCH=n\n        regexp_match:\n        - AWS_ACCESS_KEY=(?i).*aws_access_key_id( *=+ *).*(?<![A-Z0-9])[A-Z0-9]{20}(?![A-Z0-9]).*\n        - AWS_SECRET_KEY=(?i).*aws_secret_access_key( *=+ *).*(?<![A-Za-z0-9/+=])[A-Za-z0-9/+=]{40}(?![A-Za-z0-9/+=]).*\n        - PRIV_KEY=(?i)-+BEGIN(.*)PRIVATE KEY-+\n        - 'DOCKER_AUTH=(?i).*\"auth\": *\".+\"'\n        - API_KEY=(?i).*api(-|_)key( *=+ *).*(?<![A-Z0-9])[A-Z0-9]{20,60}(?![A-Z0-9]).*\n      syft:\n        parallel_workers: 2\n      windows:\n        enabled: true\n\n\n\n    logging:\n      colored_logging: false\n      exception_backtrace_logging: false\n      exception_diagnose_logging: false\n      file_retention_rule: 10\n      file_rotation_rule: 10 MB\n      log_level: <ALLOW_API_CONFIGURATION>\n      server_access_logging: true\n      server_log_level: info\n      server_response_debug_logging: false\n      structured_logging: false\n    endpoint_hostname: ${ANCHORE_ENDPOINT_HOSTNAME}\n    listen: \"0.0.0.0\"\n    port: ${ANCHORE_PORT}\n    cycle_timers:\n      analysis_data_disk_gc: 3600\n      handle_metrics: 15\n      image_analyzer: 1\n      service_heartbeat: 60\n      sync_clamav_db: 60\n      system_config_environment_watcher: 20\n      system_config_refresh_watcher: 20\n    layer_cache_enable: false\n    layer_cache_max_gigabytes: 0\n    enable_hints: false\n    enable_owned_package_filtering: \n    keep_image_analysis_tmpfiles: ${ANCHORE_KEEP_IMAGE_ANALYSIS_TMPFILES}\n    external_hostname: null\n    external_port: null\n    external_tls: false\n    server:\n      max_connection_backlog: 2048\n      max_wsgi_middleware_worker_count: 50\n      max_wsgi_middleware_worker_queue_size: 100\n      process_worker_count: 1\n      ssl_cert: false\n      ssl_chain: false\n      ssl_enable: false\n      ssl_key: false\n      timeout_graceful_shutdown: false\n      timeout_keep_alive: 5\n\n  catalog:\n    enabled: true\n    logging:\n      colored_logging: false\n      exception_backtrace_logging: false\n      exception_diagnose_logging: false\n      file_retention_rule: 10\n      file_rotation_rule: 10 MB\n      log_level: <ALLOW_API_CONFIGURATION>\n      server_access_logging: true\n      server_log_level: info\n      server_response_debug_logging: false\n      structured_logging: false\n    endpoint_hostname: ${ANCHORE_ENDPOINT_HOSTNAME}\n    listen: \"0.0.0.0\"\n    port: ${ANCHORE_PORT}\n    account_prometheus_metrics: <ALLOW_API_CONFIGURATION>\n    cycle_timers:\n      account_resource_cleanup: 30\n      alerts_watcher: 600\n      analyzer_queue: 1\n      archive_tasks: 43200\n      artifact_lifecycle_policy_tasks: 43200\n      document_view_collection_prune_watcher: 43200\n      events_gc: 43200\n      handle_deployment_metrics: 300\n      handle_metrics: 60\n      image_gc: 60\n      image_watcher: 3600\n      import_gc: 60\n      integration_account_association_expiration_watcher: 300\n      integration_health_report_ttl_watcher: 86400\n      integration_status_update_watcher: 300\n      k8s_image_watcher: 150\n      legacy_syft_hybrid_view_builder: 60\n      notifications: 30\n      policy_eval: 3600\n      repo_watcher: 60\n      resource_limit_notifications: 3600\n      resource_metrics: 300\n      runtime_inventory_image_ttl_watcher: 86400\n      sbom_vuln_scan_refresh_watcher: 60\n      sbom_vuln_scan_watcher: 10\n      service_heartbeat: 60\n      service_watcher: 15\n      source_gc: 60\n      source_import_gc: 60\n      syft_sbom_metadata_annotations: 150\n      system_config_environment_watcher: 20\n      system_config_refresh_watcher: 20\n      system_logs_gc: 43200\n      vulnerability_scan: 14400\n    event_log:\n      max_retention_age_days: 180\n      notification:\n        enabled: false\n        level:\n        - error\n    runtime_inventory:\n      inventory_ttl_days: 120\n      inventory_ingest_overwrite: false\n    integrations:\n      integration_health_report_ttl_days: 2\n    image_gc:\n      max_worker_threads: 4\n    runtime_compliance:\n      object_store_bucket: \"runtime_compliance_check\"\n    import_operation_expiration_days: 7\n    analysis_queue_priority: <ALLOW_API_CONFIGURATION>\n    sbom_vuln_scan:\n      auto_scale: true\n      batch_size: 1\n      pool_size: 1\n    analysis_archive:\n      compression:\n        enabled: true\n        min_size_kbytes: 100\n      enabled: true\n      storage_driver:\n        config:\n          access_key: ${ANCHORE_ANALYSIS_ARCHIVE_ACCESS_KEY}\n          bucket: analysisarchive\n          region: null\n          secret_key: ${ANCHORE_ANALYSIS_ARCHIVE_SECRET_KEY}\n          url: http://myminio.mynamespace.svc.cluster.local:9000\n        name: s3\n    object_store:\n      compression:\n        enabled: true\n        min_size_kbytes: 100\n      storage_driver:\n        config: {}\n        name: db\n      verify_content_digests: true\n    document_views:\n      generation:\n        max_document_execution_seconds: 300\n        multiprocess_count: 2\n        multiprocess_enabled: true\n        recycle_worker_processes_count: 10\n    system_logs:\n      expiration_days: 730\n    external_hostname: null\n    external_port: null\n    external_tls: false\n    server:\n      max_connection_backlog: 2048\n      max_wsgi_middleware_worker_count: 50\n      max_wsgi_middleware_worker_queue_size: 100\n      process_worker_count: 1\n      ssl_cert: false\n      ssl_chain: false\n      ssl_enable: false\n      ssl_key: false\n      timeout_graceful_shutdown: false\n      timeout_keep_alive: 5\n\n  simplequeue:\n    enabled: true\n    logging:\n      colored_logging: false\n      exception_backtrace_logging: false\n      exception_diagnose_logging: false\n      file_retention_rule: 10\n      file_rotation_rule: 10 MB\n      log_level: <ALLOW_API_CONFIGURATION>\n      server_access_logging: true\n      server_log_level: info\n      server_response_debug_logging: false\n      structured_logging: false\n    endpoint_hostname: ${ANCHORE_ENDPOINT_HOSTNAME}\n    listen: \"0.0.0.0\"\n    port: ${ANCHORE_PORT}\n    cycle_timers:\n      handle_metrics: 15\n      service_heartbeat: 60\n      system_config_environment_watcher: 20\n      system_config_refresh_watcher: 20\n    external_hostname: null\n    external_port: null\n    external_tls: false\n    server:\n      max_connection_backlog: 2048\n      max_wsgi_middleware_worker_count: 50\n      max_wsgi_middleware_worker_queue_size: 100\n      process_worker_count: 1\n      ssl_cert: false\n      ssl_chain: false\n      ssl_enable: false\n      ssl_key: false\n      timeout_graceful_shutdown: false\n      timeout_keep_alive: 5\n\n  policy_engine:\n    enabled: true\n    logging:\n      colored_logging: false\n      exception_backtrace_logging: false\n      exception_diagnose_logging: false\n      file_retention_rule: 10\n      file_rotation_rule: 10 MB\n      log_level: <ALLOW_API_CONFIGURATION>\n      server_access_logging: true\n      server_log_level: info\n      server_response_debug_logging: false\n      structured_logging: false\n    endpoint_hostname: ${ANCHORE_ENDPOINT_HOSTNAME}\n    listen: \"0.0.0.0\"\n    port: ${ANCHORE_PORT}\n    policy_evaluation_cache_ttl: 3600\n    enable_package_db_load: false\n    enable_user_base_image: true\n    vulnerabilities:\n      nvd_fallback_to_secondary_cvss: <ALLOW_API_CONFIGURATION>\n      extended_support:\n        rhel:\n          enabled: <ALLOW_API_CONFIGURATION>\n          versions: <ALLOW_API_CONFIGURATION>\n      matching:\n        exclude:\n          providers: []\n          package_types: []\n        default:\n          search:\n            by_cpe:\n              enabled: <ALLOW_API_CONFIGURATION>\n        ecosystem_specific:\n          dotnet:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          dpkg:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          golang:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          hex:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          java:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          javascript:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          jvm:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          python:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          rpm:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          ruby:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          rust:\n            search:\n              by_cpe:\n                enabled: <ALLOW_API_CONFIGURATION>\n          stock:\n            search:\n              by_cpe:\n                # Disabling search by CPE for the stock matcher will entirely disable binary-only matches and is not advised\n                enabled: <ALLOW_API_CONFIGURATION>\n    cycle_timers:\n      grypedb_sync: 60\n      service_heartbeat: 60\n      system_config_environment_watcher: 20\n      system_config_refresh_watcher: 20\n      vulnerability_metadata_capture: 300\n    external_hostname: null\n    external_port: null\n    external_tls: false\n    server:\n      max_connection_backlog: 2048\n      max_wsgi_middleware_worker_count: 50\n      max_wsgi_middleware_worker_queue_size: 100\n      process_worker_count: 1\n      ssl_cert: false\n      ssl_chain: false\n      ssl_enable: false\n      ssl_key: false\n      timeout_graceful_shutdown: false\n      timeout_keep_alive: 5\n\n  reports:\n    enabled: true\n    logging:\n      colored_logging: false\n      exception_backtrace_logging: false\n      exception_diagnose_logging: false\n      file_retention_rule: 10\n      file_rotation_rule: 10 MB\n      log_level: <ALLOW_API_CONFIGURATION>\n      server_access_logging: true\n      server_log_level: info\n      server_response_debug_logging: false\n      structured_logging: false\n    endpoint_hostname: ${ANCHORE_ENDPOINT_HOSTNAME}\n    listen: \"0.0.0.0\"\n    port: ${ANCHORE_PORT}\n    enable_graphiql: true\n    cycle_timers:\n      reports_scheduled_queries: 600\n      service_heartbeat: 60\n      system_config_environment_watcher: 20\n      system_config_refresh_watcher: 20\n    max_async_execution_threads: 1\n    async_execution_timeout: 48h\n    use_volume: false\n    external_hostname: null\n    external_port: null\n    external_tls: false\n    server:\n      max_connection_backlog: 2048\n      max_wsgi_middleware_worker_count: 50\n      max_wsgi_middleware_worker_queue_size: 100\n      process_worker_count: 1\n      ssl_cert: false\n      ssl_chain: false\n      ssl_enable: false\n      ssl_key: false\n      timeout_graceful_shutdown: false\n      timeout_keep_alive: 5\n\n  reports_worker:\n    enabled: true\n    logging:\n      colored_logging: false\n      exception_backtrace_logging: false\n      exception_diagnose_logging: false\n      file_retention_rule: 10\n      file_rotation_rule: 10 MB\n      log_level: <ALLOW_API_CONFIGURATION>\n      server_access_logging: true\n      server_log_level: info\n      server_response_debug_logging: false\n      structured_logging: false\n    endpoint_hostname: ${ANCHORE_ENDPOINT_HOSTNAME}\n    listen: \"0.0.0.0\"\n    port: ${ANCHORE_PORT}\n    enable_data_ingress: true\n    enable_data_egress: <ALLOW_API_CONFIGURATION>\n    data_egress_window: <ALLOW_API_CONFIGURATION>\n    data_refresh_max_workers: 10\n    data_load_max_workers: 10\n    ingress_images_max_workers: 10\n    cycle_timers:\n      event_stream_health: 60\n      reports_extended_runtime_vuln_load: 1800\n      reports_image_egress: 600\n      reports_image_load: 600\n      reports_image_refresh: 7200\n      reports_metrics: 3600\n      reports_runtime_inventory_load: 600\n      reports_tag_egress: 600\n      reports_tag_load: 600\n      reports_tag_refresh: 7200\n      service_heartbeat: 60\n      system_config_environment_watcher: 20\n      system_config_refresh_watcher: 20\n    runtime_report_generation:\n      ecs_container_vulns_per_page: 1000\n      extended_runtime_page_size: 100\n      inventory_images_by_vulnerability: true\n      k8s_container_vulns_per_page: 1000\n      k8s_namespaces_per_page: 1000\n      vulnerabilities_by_ecs_container: true\n      vulnerabilities_by_k8s_container: true\n      vulnerabilities_by_